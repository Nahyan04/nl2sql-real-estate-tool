# API process only. Docker Compose supplies DATABASE_URL using the restricted runtime role.
READONLY_DB_PASSWORD=changeme

# Enable only a configured provider.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OLLAMA_ENABLED=false
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_REASONING=false
LLM_BASE_URL=http://host.docker.internal:11434
# Only for an authenticated remote Ollama proxy.
OLLAMA_API_KEY=

# Set these for your deployed frontend/API origin pair.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
TRUSTED_PROXY_CIDRS=
