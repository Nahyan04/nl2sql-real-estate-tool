# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/postgres
READONLY_DB_PASSWORD=changeme
RUNTIME_DB_PASSWORD=change-me-runtime

# LLM provider
LLM_PROVIDER=anthropic
LLM_BASE_URL=http://host.docker.internal:11434
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_ENABLED=false
# For an authenticated remote Ollama proxy. Keep the key server-side.
OLLAMA_API_KEY=
# Use the setting from the verified local Ollama run; adjust only after retesting a different model.
OLLAMA_REASONING=false
ANTHROPIC_API_KEY=
MODEL_CALL_TIMEOUT_S=12
REQUEST_TIMEOUT_S=25
MODEL_MAX_OUTPUT_TOKENS=1200
# Low sampling variation for the configured Haiku 4.5 analytical model.
MODEL_TEMPERATURE=0
MODEL_GENERATION_ATTEMPTS=2
MODEL_CONCURRENCY=2
MODEL_QUEUE_SIZE=4
MODEL_QUEUE_WAIT_S=2

# Shared demo request guard. Apply backend/db/bayan_runtime_v1.sql before serving.
REQUEST_SESSION_MINUTE_LIMIT=30
REQUEST_SESSION_DAY_LIMIT=300
REQUEST_IP_MINUTE_LIMIT=120
REQUEST_IP_DAY_LIMIT=1200
REQUEST_GLOBAL_CONCURRENCY=8
TRUSTED_PROXY_CIDRS=
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Retrieval
EMBEDDING_ENABLED=false

# Guards applied to every generated query
QUERY_ROW_LIMIT=500
QUERY_TIMEOUT_S=5
QUERY_RESULT_BYTES=1048576
QUERY_CELL_BYTES=65536
QUERY_CONNECTIONS=4
QUERY_POOL_WAIT_S=1
